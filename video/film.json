{
	"name": "Contrast",
	"icon": "services/app/web/brand/icon.svg",
	"accent": "#4ade80",
	"module": "services/app/web/src/video.generated.ts",
	"style": "tabs",
	"fps": 30,
	"posterAt": 9,
	"shots": [
		{ "name": "home", "url": "http://localhost:4123/", "settle": 1, "maxHeight": 1100 },
		{
			"name": "result",
			"url": "http://localhost:4123/999999/ffffff",
			"settle": 1,
			"rects": { "ratio": "h1.ratio", "sample": ".sample", "levels": "ul.levels", "fix": "main p:has(a .sw)", "fixlink": "main p a:has(.sw)" }
		}
	],
	"scenes": [
		{ "kind": "card", "dur": 2.6, "fadeOut": true, "title": ["WCAG contrast,", "as a link you can share."], "pill": "your-tool.example.com/<b>999999/ffffff</b>" },
		{
			"kind": "browser", "dur": 4.0, "fadeIn": true, "tab": "Contrast",
			"imgs": [[0, "shots/home.png"], [2.4, "shots/result.png"]],
			"omni": { "from": "your-tool.example.com", "to": "your-tool.example.com/999999/ffffff", "at": 0.6, "dur": 1.4 },
			"cam": [[0, [960, 540, 1]], [0.5, [720, 140, 1.7]], [2.2, [720, 140, 1.7]], [3.0, [960, 480, 1.25]]],
			"cap": [[0.4, 3.8, "Put two colors in the address"]]
		},
		{
			"kind": "browser", "dur": 4.0, "tab": "#999999 on #ffffff · Contrast", "url": "your-tool.example.com/999999/ffffff",
			"imgs": [[0, "shots/result.png"]],
			"cam": [[0, [960, 480, 1.25]], [1.0, "@result.sample:w1.55"], [4.0, "@result.sample:w1.55"]],
			"hl": [[1.1, 3.8, "@result.ratio"]],
			"cap": [[0.3, 3.8, "The contrast ratio, at once"]]
		},
		{
			"kind": "browser", "dur": 4.0, "tab": "#999999 on #ffffff · Contrast", "url": "your-tool.example.com/999999/ffffff",
			"imgs": [[0, "shots/result.png"]],
			"cam": [[0, "@result.sample:w1.55"], [1.2, "@result.levels:w1.5"], [4.0, "@result.levels:w1.5"]],
			"hl": [[1.3, 3.8, "@result.levels"]],
			"cap": [[0.3, 3.8, "Every WCAG level, pass or fail"]]
		},
		{
			"kind": "browser", "dur": 4.0, "fadeOut": true, "tab": "#999999 on #ffffff · Contrast", "url": "your-tool.example.com/999999/ffffff",
			"imgs": [[0, "shots/result.png"]],
			"cam": [[0, "@result.levels:w1.5"], [1.0, "@result.fix:w1.7"], [4.0, "@result.fix:w1.7"]],
			"cursor": [[0.8, [1000, 300]], [1.8, "@result.fixlink:c"]],
			"clicks": [2.0],
			"hl": [[2.0, 3.8, "@result.fix"]],
			"cap": [[0.3, 3.8, "And the nearest color that passes"]]
		},
		{ "kind": "card", "dur": 3.4, "fadeIn": true, "title": ["Your tool here."], "sub": "SEO, icons, this film and a launch kit, already done", "pill": "bun run rename --name <b>Acme</b>" }
	]
}
