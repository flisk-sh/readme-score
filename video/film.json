{
	"name": "README Score",
	"icon": "services/app/web/brand/icon.svg",
	"accent": "#4ade80",
	"module": "services/app/web/src/video.generated.ts",
	"style": "tabs",
	"fps": 30,
	"posterAt": 9,
	"shots": [
		{ "name": "home", "url": "http://localhost:4177/", "settle": 1, "maxHeight": 1100 },
		{
			"name": "result",
			"url": "http://localhost:4177/flisk-sh/flisk",
			"settle": 2,
			"maxHeight": 1500,
			"rects": { "score": "h1.score", "fixes": "main ul.checks", "fix": "main ul.checks .fix", "sections": "h2#sections" }
		}
	],
	"scenes": [
		{ "kind": "card", "dur": 2.6, "fadeOut": true, "title": ["Your README,", "scored out of 100."], "pill": "readme.flisk.ai/<b>owner/repo</b>" },
		{
			"kind": "browser", "dur": 4.0, "fadeIn": true, "tab": "README Score",
			"imgs": [[0, "shots/home.png"], [2.4, "shots/result.png"]],
			"omni": { "from": "readme.flisk.ai", "to": "readme.flisk.ai/flisk-sh/flisk", "at": 0.6, "dur": 1.4 },
			"cam": [[0, [960, 540, 1]], [0.5, [720, 140, 1.7]], [2.2, [720, 140, 1.7]], [3.0, [960, 480, 1.25]]],
			"cap": [[0.4, 3.8, "Put a GitHub repository in the address"]]
		},
		{
			"kind": "browser", "dur": 4.0, "tab": "flisk-sh/flisk: README score", "url": "readme.flisk.ai/flisk-sh/flisk",
			"imgs": [[0, "shots/result.png"]],
			"cam": [[0, [960, 480, 1.25]], [1.0, "@result.score:w1.8"], [4.0, "@result.score:w1.8"]],
			"hl": [[1.1, 3.8, "@result.score"]],
			"cap": [[0.3, 3.8, "A score from fixed rules, no AI"]]
		},
		{
			"kind": "browser", "dur": 4.0, "fadeOut": true, "tab": "flisk-sh/flisk: README score", "url": "readme.flisk.ai/flisk-sh/flisk",
			"imgs": [[0, "shots/result.png"]],
			"cam": [[0, "@result.score:w1.8"], [1.2, "@result.fixes:w1.4"], [4.0, "@result.fixes:w1.4"]],
			"hl": [[1.3, 3.8, "@result.fix"]],
			"cap": [[0.3, 3.8, "Every miss, its line and the fix"]]
		},
		{ "kind": "card", "dur": 3.4, "fadeIn": true, "title": ["Same README,", "same score."], "sub": "23 checks, every threshold on /checks", "pill": "readme.flisk.ai/<b>flisk-sh/flisk</b>" }
	]
}
